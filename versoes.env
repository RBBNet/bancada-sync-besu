# Versões fixadas de tudo o que a bancada usa. Mudar aqui = mudar o experimento.

# Besu sob teste, escolhido por BESU=<versão> na execução (padrão: a primeira).
# 25.5.0: versão em que o travamento foi observado. 25.12.0: versão recente, para saber se o defeito persiste.
BESU_VERSOES="25.5.0 25.12.0"
BESU_IMAGEM_25_5_0=hyperledger/besu:25.5.0@sha256:607e5dd4c90bd4fcd6d0d8ff2e5da51c93079cc25c69b694287d88823476c43d
BESU_IMAGEM_25_12_0=hyperledger/besu:25.12.0@sha256:4ef9e934bb321d916ff245981fd65100dc41446b26b2bed47a2b7d09139a3cbe

# Besu usado só pelo rbb-cli (geração de chaves e do extraData do gênesis); não muda com BESU
BESU_IMAGEM_RBB_CLI=hyperledger/besu:25.5.0@sha256:607e5dd4c90bd4fcd6d0d8ff2e5da51c93079cc25c69b694287d88823476c43d

# Scripts de montagem de rede da RBB (commit exato)
START_NETWORK_REPO=https://github.com/RBBNet/start-network.git
START_NETWORK_COMMIT=b2aa320fa8ff7f2fa5c85a30894787146751f433

# Ferramentas
NODE_VERSAO_MINIMA=20
